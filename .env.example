# --- AUTOMEX CarFlow environment template ---
# Copy to .env and fill in values. The app must boot with every *_ENABLED flag
# left False and every credential left blank (agent.md §12).

# --- Django core ---
# Secret key for cryptographic signing — generate a long random value.
DJANGO_SECRET_KEY=local-dev-secret-key-not-for-production
# Never True outside local development.
DJANGO_DEBUG=True
# Comma-separated hosts the app will serve (e.g. localhost,carflow.example.com).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional: full URLs (with scheme) trusted for CSRF Origin checks. Normally
# leave blank — they are auto-derived from DJANGO_ALLOWED_HOSTS.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Django settings module override (compose files set this already).
DJANGO_SETTINGS_MODULE=config.settings.prod
# Plain-HTTP stack: secure cookies would break CSRF/session over http.
COOKIES_SECURE=False

# --- PostgreSQL ---
# Database name used by the app and the db container.
DB_NAME=carflow
# Database user used by the app and the db container.
DB_USER=carflow
# Database password used by the app and the db container.
DB_PASSWORD=carflow-local-dev
# Hostname of the PostgreSQL service (compose service name).
DB_HOST=db
# PostgreSQL port.
DB_PORT=5432

# --- Redis (cache + Celery broker) ---
# Full Redis URL used as Django cache, Celery broker and result backend.
REDIS_URL=redis://redis:6379/0

# --- Gunicorn ---
# Number of Gunicorn worker processes.
GUNICORN_WORKERS=3
# Gunicorn worker timeout in seconds.
GUNICORN_TIMEOUT=60

# --- Nginx ---
# Host port mapped to Nginx in the production compose file.
NGINX_PORT=8765

# --- Meta (WhatsApp / Messenger / Instagram) ---
# Master toggle; when False the Null adapter is used and credentials may be blank.
META_ENABLED=False
# Meta developer app ID.
META_APP_ID=
# Meta developer app secret (webhook signature verification).
META_APP_SECRET=
# Long-lived system user access token for the Graph API.
META_ACCESS_TOKEN=
# Shared secret used for webhook URL verification (hub.challenge handshake).
META_WEBHOOK_VERIFY_TOKEN=
# WhatsApp Business phone number ID used for outbound messages.
META_WHATSAPP_PHONE_NUMBER_ID=
# Graph API page ID used for Messenger inbound/outbound.
META_MESSENGER_PAGE_ID=
# Instagram-scoped page ID used for Instagram DM inbound/outbound.
META_INSTAGRAM_PAGE_ID=

# --- Telegram ---
# Master toggle; when False the Null adapter is used and the token may be blank.
TELEGRAM_ENABLED=False
# Bot token issued by BotFather.
TELEGRAM_BOT_TOKEN=

# --- SMS Gateway ---
# Master toggle; when False the Null adapter is used and credentials may be blank.
SMS_ENABLED=False
# Base URL of the SMS gateway provider API.
SMS_GATEWAY_URL=
# API key for the SMS gateway provider.
SMS_GATEWAY_API_KEY=

# --- Email ---
# Master toggle; when False Django's console email backend is used.
EMAIL_ENABLED=False
# SMTP host.
EMAIL_HOST=
# SMTP port.
EMAIL_PORT=587
# SMTP username.
EMAIL_HOST_USER=
# SMTP password.
EMAIL_HOST_PASSWORD=
# Whether to use TLS for the SMTP connection.
EMAIL_USE_TLS=True
# From address used for outbound email.
DEFAULT_FROM_EMAIL=notifications@localhost

# --- S3-compatible object storage ---
# Master toggle; when False files are stored on the local media volume.
S3_ENABLED=False
# Endpoint URL of the S3-compatible provider.
S3_ENDPOINT_URL=
# Access key ID.
S3_ACCESS_KEY=
# Secret access key.
S3_SECRET_KEY=
# Bucket name for uploaded media.
S3_BUCKET_NAME=

# Host port mapped to the Django dev server (docker-compose.override.yml).
DEV_PORT=8000

# Optional: production log verbosity (prod settings only). Default INFO.
DJANGO_LOG_LEVEL=INFO
